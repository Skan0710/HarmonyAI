PORT=5000
NODE_ENV=development
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# CORS: comma-separated list of allowed origins (no trailing slash)
# In development, all origins are allowed when CORS_ORIGIN is unset.
# In production, set this explicitly (e.g. https://yourdomain.com).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Supabase Database & Auth Configuration
SUPABASE_URL=https://xyjfwwztbtsqzegargpa.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini LLM — powers the AI assistant, contextual recommendations, AI playlist
# generation, and semantic search embeddings. Leave unset to run on rule-based/
# local fallbacks only (no cost, no external calls).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# YouTube Data API v3 — resolves each song to a playable YouTube video ID for
# full-length playback via the YouTube IFrame Player API on the frontend.
# Free tier: 10,000 quota units/day, 100 units per search (~100 new song
# lookups/day; already-resolved songs are cached and cost nothing further).
# Leave unset to fall back to the placeholder demo audio_url only.
# Get a key at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first)
YOUTUBE_API_KEY=
