PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/harmonyai
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# CORS: comma-separated list of allowed origins (no trailing slash)
# In development, all origins are allowed when CORS_ORIGIN is unset.
# In production, set this explicitly (e.g. https://yourdomain.com).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Supabase Database & Auth Configuration
SUPABASE_URL=https://xyjfwwztbtsqzegargpa.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq LLM (free tier) — powers the AI assistant, contextual recommendations, and
# AI playlist generation. Leave unset to run on rule-based fallbacks only (no cost, no external calls).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

